{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture",
  "type": "object",
  "required": ["pattern", "services", "connections"],
  "properties": {
    "pattern": {"type": "string"},
    "services": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "role"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "role": {"type": "string"},
          "rationale": {"type": "string"},
          "config": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "label": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "security_controls": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
